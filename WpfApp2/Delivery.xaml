<Window x:Class="WpfApp2.Delivery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Доставка" Height="550" Width="800">
    <Grid Background="LightCyan">
        <Border MinWidth="400" Margin ="15" Background="White" VerticalAlignment="Center" Padding="30" MaxWidth="550" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Доставка."   FontSize="18"  FontWeight="Bold" Height="22" Width="150" Margin="350 0 0 25"/>
                <!--<TextBlock x:Name="exText"  FontWeight="Bold" Margin="0 0 0 20"/>-->
                <TextBox x:Name="Drag"  materialDesign:HintAssist.Hint="Введите наименование лекарства" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                <TextBlock  Text="Выберите дату доставки"  materialDesign:HintAssist.Hint="Выберите дату доставки" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                <DatePicker x:Name="Date" Height="25" HorizontalAlignment="Left" Margin="0,0,0,0"   Width="115" />
                <!--<PasswordBox materialDesign:HintAssist.Hint="Введите пароль" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>-->
                <Button x:Name="Order"  Content="Заказать доставку" Click="Button_Order_click" Margin="300 50 0 0 " />
                <Button x:Name="Return"  Content="Вернуться в кабинет" Click="Button_return_click" Margin="0 -32 300 0 " />
            </StackPanel>
        </Border>
    </Grid>
</Window>
